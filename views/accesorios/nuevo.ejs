<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Agregar Accesorio</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="topbar">
    <h1><img src="/images/logo.png" alt="Logo" class="topbar-logo"> Agregar Accesorio</h1>
  </div>

  <div class="container">
    <a href="/accesorios" class="volver">Volver a accesorios</a>

    <div class="form-card">
      <form action="/accesorios" method="POST">
        <div class="form-grid">
          <div class="form-group full">
            <label>Nombre *</label>
            <input type="text" name="nombre" required placeholder="Ej. Biberón para becerro">
          </div>

          <div class="form-group">
            <label>Categoría</label>
            <input type="text" name="categoria" placeholder="Perro, Gato, Ganado...">
          </div>

          <div class="form-group">
            <label>Precio de compra</label>
            <input type="number" step="0.01" name="precio_compra">
          </div>

          <div class="form-group">
            <label>Precio de venta</label>
            <input type="number" step="0.01" name="precio_venta">
          </div>

          <div class="form-group">
            <label>Stock (piezas)</label>
            <input type="number" step="1" name="stock" value="0">
          </div>

          <div class="form-group">
            <label>Stock mínimo (piezas)</label>
            <input type="number" step="1" name="stock_minimo" value="0">
          </div>

          <div class="form-group">
            <label>Proveedor</label>
            <input type="text" name="proveedor">
          </div>

          <div class="form-group">
            <label>Fecha de entrega</label>
            <input type="date" name="fecha_entrega">
          </div>

          <div class="form-group">
            <label>Fecha de recibido</label>
            <input type="date" name="fecha_recibido">
          </div>
        </div>

        <button type="submit" class="btn-guardar">Guardar Accesorio</button>
      </form>
    </div>
  </div>
</body>
</html>