<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Editar Accesorio</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="topbar">
    <h1><img src="/images/logo.png" alt="Logo" class="topbar-logo"> Editar Accesorio</h1>
  </div>

  <div class="container">
    <a href="/accesorios" class="volver">Volver a accesorios</a>

    <div class="form-card">
      <form action="/accesorios/<%= accesorio.id %>" method="POST">
        <div class="form-grid">
          <div class="form-group full">
            <label>Nombre *</label>
            <input type="text" name="nombre" value="<%= accesorio.nombre %>" required>
          </div>

          <div class="form-group">
            <label>Categoría</label>
            <input type="text" name="categoria" value="<%= accesorio.categoria || '' %>">
          </div>

          <div class="form-group">
            <label>Precio de compra</label>
            <input type="number" step="0.01" name="precio_compra" value="<%= accesorio.precio_compra || '' %>">
          </div>

          <div class="form-group">
            <label>Precio de venta</label>
            <input type="number" step="0.01" name="precio_venta" value="<%= accesorio.precio_venta || '' %>">
          </div>

          <div class="form-group">
            <label>Stock (piezas)</label>
            <input type="number" step="1" name="stock" value="<%= accesorio.stock %>">
          </div>

          <div class="form-group">
            <label>Stock mínimo (piezas)</label>
            <input type="number" step="1" name="stock_minimo" value="<%= accesorio.stock_minimo || '' %>">
          </div>

          <div class="form-group">
            <label>Proveedor</label>
            <input type="text" name="proveedor" value="<%= accesorio.proveedor || '' %>">
          </div>

          <div class="form-group">
            <label>Fecha de entrega</label>
            <input type="date" name="fecha_entrega" value="<%= accesorio.fecha_entrega || '' %>">
          </div>

          <div class="form-group">
            <label>Fecha de recibido</label>
            <input type="date" name="fecha_recibido" value="<%= accesorio.fecha_recibido || '' %>">
          </div>
        </div>

        <button type="submit" class="btn-guardar">Guardar Cambios</button>
      </form>
    </div>
  </div>
</body>
</html>