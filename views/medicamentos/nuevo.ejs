<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Agregar Medicamento</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="topbar">
    <h1><img src="/images/logo.png" alt="Logo" class="topbar-logo"> Agregar Medicamento</h1>
  </div>

  <div class="container">
    <a href="/medicamentos" class="volver">Volver a medicamentos</a>

    <div class="form-card">
      <form action="/medicamentos" method="POST">
        <div class="form-grid">
          <div class="form-group full">
            <label>Nombre *</label>
            <input type="text" name="nombre" required placeholder="Ej. Ivermectina 1%">
          </div>

          <div class="form-group full">
            <label>Descripción</label>
            <input type="text" name="descripcion" placeholder="Para qué sirve, dosis, indicaciones...">
          </div>

          <div class="form-group">
            <label>Presentación</label>
            <input type="text" name="presentacion" placeholder="Frasco 100 ml, Tabletas, Pipeta...">
          </div>

          <div class="form-group">
            <label>Especie</label>
            <input type="text" name="especie" placeholder="Perro, Gato, Ganado, Aves, Todas...">
          </div>

          <div class="form-group">
            <label>Precio de compra</label>
            <input type="number" step="0.01" name="precio_compra">
          </div>

          <div class="form-group">
            <label>Precio de venta</label>
            <input type="number" step="0.01" name="precio_venta">
          </div>

          <div class="form-group">
            <label>Stock (piezas)</label>
            <input type="number" step="1" name="stock" value="0">
          </div>

          <div class="form-group">
            <label>Stock mínimo (piezas)</label>
            <input type="number" step="1" name="stock_minimo" value="0">
          </div>

          <div class="form-group">
            <label>Lote</label>
            <input type="text" name="lote">
          </div>

          <div class="form-group">
            <label>Fecha de caducidad</label>
            <input type="date" name="fecha_caducidad">
          </div>

          <div class="form-group">
            <label>Proveedor</label>
            <input type="text" name="proveedor">
          </div>

          <div class="form-group">
            <label>
              <input type="checkbox" name="requiere_receta"> Requiere receta
            </label>
          </div>
        </div>

        <button type="submit" class="btn-guardar">Guardar Medicamento</button>
      </form>
    </div>
  </div>
</body>
</html>