<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Editar Producto</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="topbar">
    <h1><img src="/images/logo.png" alt="Logo" class="topbar-logo"> Editar Producto</h1>
  </div>

  <div class="container">
    <a href="/productos" class="volver">Volver al inventario</a>

    <div class="form-card">
      <form action="/productos/<%= producto.id %>" method="POST">
        <div class="form-grid">
          <div class="form-group full">
            <label>Nombre *</label>
            <input type="text" name="nombre" value="<%= producto.nombre %>" required>
          </div>

          <div class="form-group">
            <label>Marca</label>
            <input type="text" name="marca" value="<%= producto.marca || '' %>">
          </div>

          <div class="form-group">
            <label>Categoría</label>
            <input type="text" name="categoria" value="<%= producto.categoria || '' %>">
          </div>

          <div class="form-group">
            <label>Peso por saco (kg)</label>
            <input type="number" step="0.01" name="peso_saco" value="<%= producto.peso_saco || '' %>">
          </div>

          <div class="form-group">
            <label>Precio por kilo</label>
            <input type="number" step="0.01" name="precio_kilo" value="<%= producto.precio_kilo || '' %>">
          </div>

          <div class="form-group">
            <label>Precio por saco</label>
            <input type="number" step="0.01" name="precio_saco" value="<%= producto.precio_saco || '' %>">
          </div>

          <div class="form-group">
            <label>Precio de compra</label>
            <input type="number" step="0.01" name="precio_compra" value="<%= producto.precio_compra || '' %>">
          </div>

          <div class="form-group">
            <label>Sacos en existencia (aprox.)</label>
            <input type="number" step="0.01" id="cantidad_sacos" placeholder="Ej. 12">
            <small>Escribe aquí solo si quieres recalcular el stock en base a sacos completos</small>
          </div>

          <div class="form-group">
            <label>Stock actual (kg)</label>
            <input type="number" step="0.01" name="stock_kilos" id="stock_kilos" value="<%= producto.stock_kilos %>">
          </div>

          <div class="form-group">
            <label>Stock mínimo (kg)</label>
            <input type="number" step="0.01" name="stock_minimo" value="<%= producto.stock_minimo || '' %>">
          </div>

          <div class="form-group">
            <label>Proveedor</label>
            <input type="text" name="proveedor" value="<%= producto.proveedor || '' %>">
          </div>

          <div class="form-group">
            <label>Fecha de entrega</label>
            <input type="date" name="fecha_entrega" value="<%= producto.fecha_entrega || '' %>">
          </div>

          <div class="form-group">
            <label>Fecha de recibido</label>
            <input type="date" name="fecha_recibido" value="<%= producto.fecha_recibido || '' %>">
          </div>
        </div>

        <button type="submit" class="btn-guardar">Guardar Cambios</button>
      </form>
    </div>
  </div>

  <script>
    const inputSacos = document.getElementById('cantidad_sacos');
    const inputPesoSaco = document.querySelector('input[name="peso_saco"]');
    const inputStockKilos = document.getElementById('stock_kilos');

    function calcularStockDesdeSacos() {
      const sacos = parseFloat(inputSacos.value) || 0;
      const pesoSaco = parseFloat(inputPesoSaco.value) || 0;
      if (sacos > 0 && pesoSaco > 0) {
        inputStockKilos.value = (sacos * pesoSaco).toFixed(2);
      }
    }

    inputSacos.addEventListener('input', calcularStockDesdeSacos);
  </script>
</body>
</html>